# NVIDIA Build's OpenAI-compatible endpoint, for example:
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=
# Set true for models that support NVIDIA's thinking toggle.
OPENAI_DISABLE_THINKING=

# Required to enable the staff PIN. SESSION_SECRET must be a unique random value
# (for example: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))").
# STAFF_PIN_SCRYPT_HASH format: scrypt\$N\$r\$p\$saltBase64url\$hashBase64url
# Escape each $ in .env.local so Next does not expand it as an environment variable.
SESSION_SECRET=
STAFF_PIN_SCRYPT_HASH=

# Optional. A writable local cache for the multilingual E5 query model.
# The pre-indexed corpus does not need this cache to bootstrap.
SECURE_RAG_MODEL_CACHE=

# Optional. Keep runtime SQLite and copied source PDFs outside the project.
SECURE_RAG_RUNTIME_DIR=

# Required in production (Vercel). HMAC secret for audit and citation fingerprints.
# Must not reuse SESSION_SECRET.
AUDIT_FINGERPRINT_SECRET=

# Hosted backend (required on Vercel).
# NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY come from the
# new API keys page. Corpus read/write needs the server secret — never prefix it
# with NEXT_PUBLIC_.
#   docker compose run --rm app npm run check:supabase
#   docker compose run --rm app npm run push:supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy aliases:
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

